APP_NAME="PANTAU SEPANGKEP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pantausepangkep.my.id
APP_TIMEZONE=Asia/Makassar

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ----- Database (MySQL / MariaDB) -----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pantau_sepangkep_new
DB_USERNAME=pantau
DB_PASSWORD=sepangkep

# ----- Sesi: pengguna tetap login sampai menekan "Keluar" -----
SESSION_DRIVER=database
SESSION_LIFETIME=525600
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@domainanda.go.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ----- Akun admin awal (dipakai sekali saat db:seed) -----
ADMIN_PASSWORD=GantiSaya123

# ----- Web Push (notifikasi HP) -----
# Jalankan: php artisan pantau:vapid --write
VAPID_SUBJECT="mailto:email-admin@bps.go.id"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ----- Google Drive (penyimpanan lampiran) -----
GOOGLE_DRIVE_ENABLED=false
# oauth = akun Google kantor (disarankan) | service_account
GOOGLE_DRIVE_AUTH=oauth
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Kosongkan: token didapat otomatis lewat tombol "Hubungkan akun Google" di Admin › Pengaturan
GOOGLE_DRIVE_REFRESH_TOKEN=
# Opsional: ID folder/Shared Drive tempat folder "PANTAU SEPANGKEP" dibuat (kosong = My Drive)
GOOGLE_DRIVE_PARENT_FOLDER_ID=
GOOGLE_DRIVE_ROOT_FOLDER="PANTAU SEPANGKEP"
# none | domain | anyone  (izin baca link file di Drive)
GOOGLE_DRIVE_SHARE=none
GOOGLE_DRIVE_SHARE_DOMAIN=bps.go.id
GOOGLE_DRIVE_KEEP_LOCAL=false
# Hanya untuk GOOGLE_DRIVE_AUTH=service_account
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=storage/app/private/google-service-account.json
GOOGLE_DRIVE_IMPERSONATE=
